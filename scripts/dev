#!/usr/bin/env bash
# Run votyper from the source folder: stops any running copy first, then starts
# the code in this folder using the private Python made by scripts/install.sh.

root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
python="$HOME/.local/share/votyper/venv/bin/python"

[ -x "$python" ] || { echo "Run scripts/install.sh first." >&2; exit 1; }

pkill -f "share/votyper/venv/bin/python" || true    # the installed copy, or a previous dev run
sleep 1                                              # let it release the hotkey and microphone

PYTHONPATH="$root" exec "$python" -m votyper
